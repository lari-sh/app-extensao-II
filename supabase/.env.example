# Somente servidor local: preencher em .env.local, nunca na build Flutter.
# Obter as chaves da instancia local com supabase status, sem publica-las.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
PHOTO_CLEANUP_SECRET=
# Fixtures locais descartaveis; nunca contas reais.
FIXTURE_PASSWORD=
ALLOW_LOCAL_FIXTURES=false
